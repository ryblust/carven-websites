{
  "name": "carven-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/content/main.ts && vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "content": "node scripts/content/main.ts",
    "check:links": "node scripts/check-links.mjs",
    "playground:build": ".deps/carven/xmakew build"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@shikijs/magic-move": "4.5.0",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "domutils": "4.0.2",
    "effect": "4.0.4",
    "html-react-parser": "6.1.8",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.4",
    "@effect/vitest": "4.0.4",
    "@shikijs/langs": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "marked": "18.1.1",
    "marked-gfm-heading-id": "4.1.4",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  }
}
